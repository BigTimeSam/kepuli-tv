{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "default_locale": "en",
  "version": "1.12.0",
  "description": "__MSG_appDesc__",
  "browser_specific_settings": {
    "gecko": {
      "id": "kepuli-tv@bigtimesam.github.io",
      "strict_min_version": "130.0",
      "data_collection_permissions": { "required": ["authenticationInfo"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": ["storage", "unlimitedStorage", "declarativeNetRequestWithHostAccess", "alarms"],
  "optional_permissions": ["notifications"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Kepuli-TV",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
