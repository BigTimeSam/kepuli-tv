{
  "manifest_version": 3,
  "name": "Kepuli-TV – IPTV Player",
  "version": "1.2.4",
  "description": "Watch your own Xtream Codes IPTV in your browser without fighting the app. Channels open in seconds, and MKV plays with subtitles.",
  "browser_specific_settings": {
    "gecko": {
      "id": "kepuli-tv@bigtimesam.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["authenticationInfo"] }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Kepuli-TV",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
