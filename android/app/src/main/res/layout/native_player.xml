<?xml version="1.0" encoding="utf-8"?>
<!-- The app's own player's picture (NativePlayer): Media3's view with no
     controls of its own, which are the app's (PlayerControls). A texture,
     not a surface: the layer it lies in cuts holes in itself where the
     page draws a menu or a message over the picture, and a surface is not
     cut by its parent's drawing. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/native_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:surface_type="texture_view"
    app:show_buffering="never"
    app:use_controller="false"
    app:resize_mode="fit" />
